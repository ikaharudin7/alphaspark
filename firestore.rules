rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users can read and write their own user document
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Groups - users can read groups they belong to
    match /groups/{groupId} {
      allow read: if request.auth != null &&
                     request.auth.uid in resource.data.members;
      allow write: if request.auth != null &&
                      request.auth.uid in resource.data.admins;
    }

    // Questions - global read access for authenticated users
    match /questions/{questionId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
                      request.auth.uid in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.adminGroups;
    }

    // Group comments - only members of the group can read/write
    match /groupComments/{commentPath=**} {
      allow read, write: if request.auth != null &&
                           isGroupMember(getGroupIdFromPath(commentPath));
    }

    // Group chats - only members of the group can read/write
    match /groupChats/{groupId}/conversations/{conversationId}/messages/{messageId} {
      allow read, write: if request.auth != null &&
                           request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.members;
    }

    // Helper functions
    function isGroupMember(groupId) {
      return request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.members;
    }

    function getGroupIdFromPath(path) {
      return path.split('_')[1];
    }
  }
}